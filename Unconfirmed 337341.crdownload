  MessageSquare,
  Bot,
  Workflow,
  Zap,
  CheckCircle,
  Clock,
  Users,
  ArrowRight,
  ChevronRight,
  Sparkles,
  Database,
  Link,
  Code,
  Play,
  Settings,
  FileText,
  Layout,
  BarChart,
  Shield,
} = lucide;

// Design tokens
const COLORS = {
  canvas: "#F9F8F6",
  ink: "#1B1B18",
  inkSoft: "#6B6B62",
  charcoal: "#1E2022",
  charcoalLine: "#33363A",
  gold: "#C9A227",
  teal: "#3FA796",
};

// ---- Custom hook for scroll animations ----
function useIntersection(ref, options = { threshold: 0.2, triggerOnce: true }) {
  const [isVisible, setIsVisible] = React.useState(false);
  React.useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        setIsVisible(true);
        if (options.triggerOnce) observer.unobserve(el);
      } else if (!options.triggerOnce) {
        setIsVisible(false);
      }
    }, { threshold: options.threshold });
    observer.observe(el);
    return () => observer.disconnect();
  }, [ref, options.threshold, options.triggerOnce]);
  return isVisible;
}

// ---- FadeIn component ----
const FadeIn = React.memo(({ children, delay = 0, className = "" }) => {
  const ref = React.useRef(null);
  const isVisible = useIntersection(ref);
  const transition = `transition-all duration-700 ease-out ${delay ? `delay-[${delay}ms]` : ""}`;
  return (
    <div
      ref={ref}
      className={`${className} ${transition} ${isVisible ? "opacity-100 translate-y-0" : "opacity-0 translate-y-8"}`}
    >
      {children}
    </div>
  );
});

// ---- Badge component ----
const Badge = React.memo(({ children, tone = "neutral" }) => {
  const tones = {
    neutral: "bg-[#2A2D2F] text-[#D8D6CE] border-[#3A3D3F]",
    gold: "bg-[#C9A227]/15 text-[#C9A227] border-[#C9A227]/30",
    teal: "bg-[#3FA796]/15 text-[#3FA796] border-[#3FA796]/30",
  };
  return (
    <span className={`inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-medium ${tones[tone]}`}>
      {children}
    </span>
  );
});

